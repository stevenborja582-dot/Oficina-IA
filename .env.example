# ─────────────────────────────────────────────────────────────
#  Oficina Black Hole v2 — variables de entorno (Fase 1)
#  Copia este archivo como .env y rellena los valores reales.
#  El archivo .env NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────
# Puerto local del servidor Express.
PUERTO=3000
# URL pública de la app. Debe coincidir con el dominio real en producción
# porque de aquí se construye la URI de redirección de Google.
URL_BASE=http://localhost:3000
# development | production
NODE_ENV=development

# ── Sesión ────────────────────────────────────────────────────
# Cadena larga y aleatoria que firma la cookie de sesión.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRETO_SESION=cambia-esto-por-una-cadena-larga-y-aleatoria
# Días que dura la sesión antes de pedir login otra vez.
DIAS_SESION=30

# ── Base de datos ─────────────────────────────────────────────
# Ruta del archivo SQLite (relativa a la raíz del repo o absoluta).
RUTA_BD=./datos/oficina.sqlite

# ── Google OAuth (Passport) ───────────────────────────────────
# Se obtienen en https://console.cloud.google.com
#   APIs y servicios → Credenciales → Crear credenciales
#   → ID de cliente de OAuth 2.0 → Aplicación web
# URI de redirección autorizada que hay que registrar allí:
#   http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lista de correos (separados por comas) que entran como administradores.
# El PRIMER usuario que se registra siempre queda como admin, aunque
# esta lista esté vacía.
ADMINS=tu-correo@gmail.com

# Si se deja vacío, cualquier cuenta de Google puede entrar.
# Si pones correos o dominios (@midominio.com), solo esos podrán entrar.
CORREOS_PERMITIDOS=

# ── Modo demo (solo desarrollo) ───────────────────────────────
# true  → habilita "Entrar en modo demo", un login local sin Google para
#         poder probar la app antes de tener las credenciales listas.
# El servidor se niega a arrancar si esto está en true con NODE_ENV=production.
AUTH_PERMITIR_DEMO=true

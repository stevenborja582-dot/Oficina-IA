# ─────────────────────────────────────────────────────────────
#  Oficina Black Hole v2 — variables de entorno (Fase 1)
#  Copia este archivo como .env y rellena los valores reales.
#  El archivo .env NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────
# Puerto local del servidor Express.
PUERTO=3000
# URL pública de la app. Debe coincidir con el dominio real en producción
# porque de aquí se construye la URI de redirección de Google.
URL_BASE=http://localhost:3000
# development | production
NODE_ENV=development

# ── Sesión ────────────────────────────────────────────────────
# Cadena larga y aleatoria que firma la cookie de sesión.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRETO_SESION=cambia-esto-por-una-cadena-larga-y-aleatoria
# Días que dura la sesión antes de pedir login otra vez.
DIAS_SESION=30

# ── Base de datos ─────────────────────────────────────────────
# Ruta del archivo SQLite (relativa a la raíz del repo o absoluta).
RUTA_BD=./datos/oficina.sqlite

# ── Acceso: Google OAuth (Passport) ───────────────────────────
# Se obtienen en https://console.cloud.google.com
#   APIs y servicios → Credenciales → Crear credenciales
#   → ID de cliente de OAuth 2.0 → Aplicación web
# URI de redirección autorizada que hay que registrar allí:
#   http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Quién entra y quién manda ─────────────────────────────────
# Correos (separados por comas) que entran como administradores.
# El PRIMER usuario que se registra siempre queda como admin, aunque
# esta lista esté vacía: si no, la oficina nacería sin nadie al mando.
ADMINS=tu-correo@gmail.com

# Lista de acceso. Vacía = cualquiera con cuenta del proveedor puede entrar.
# Acepta correos sueltos y dominios enteros: "yo@gmail.com, @miempresa.com".
# Desde la Fase 5 hay una tercera puerta: las invitaciones que crees en la
# pantalla Equipo valen aunque el correo no esté en esta lista.
CORREOS_PERMITIDOS=

# ── Modo demo (solo desarrollo) ───────────────────────────────
# true  → habilita "Entrar en modo demo", un login local sin Google para
#         poder probar la app antes de tener las credenciales listas.
# El servidor se niega a arrancar si esto está en true con NODE_ENV=production.
AUTH_PERMITIR_DEMO=true

# ── Fase 2 · Proveedores de IA ────────────────────────────────
# Cada personaje elige su proveedor. Solo hace falta la clave del que uses.
# Si falta una clave, la interfaz lo dice en vez de romperse a medio chat.

# Anthropic (proveedor por defecto) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo que usan los personajes de Anthropic que no indiquen uno propio.
MODELO_ANTHROPIC=claude-opus-5

# OpenAI (opcional) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Sin valor aquí, cada personaje de OpenAI tiene que indicar su modelo en su ficha.
MODELO_OPENAI=

# Google AI (opcional) — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
MODELO_GOOGLE=

# Techo de tokens por respuesta y cuántos mensajes previos se reenvían.
IA_MAXIMO_TOKENS=32000
IA_MENSAJES_CONTEXTO=40

# Solo si hablas con Anthropic a través de una pasarela propia. Vacío = API oficial.
ANTHROPIC_URL_BASE=

# ── Fase 4 · Conectores MCP ───────────────────────────────────────
# Un conector de tipo "proceso" lanza una orden del sistema (npx, uvx…).
# En tu equipo es justo lo que quieres; en un servidor compartido es
# ejecución de código para cualquiera que administre la oficina, así que
# en producción viene apagado. Actívalo solo si confías en quién entra.
MCP_PERMITIR_STDIO=true
# Paciencia con un servidor MCP lento, y techo del resultado que entra
# en el contexto del modelo.
MCP_ESPERA_CONEXION_MS=20000
MCP_ESPERA_LLAMADA_MS=60000
MCP_MINUTOS_INACTIVIDAD=15
MCP_MAXIMO_CARACTERES=12000
# Cuántas veces seguidas puede el personaje llamar a herramientas antes de
# tener que responder.
MCP_MAXIMO_VUELTAS=8

# ── Fase 5 · Equipo y despliegue ──────────────────────────────────
# Segundo proveedor de login. Se crea en GitHub → Settings → Developer
# settings → OAuth Apps, con la URI de redirección:
#   http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
